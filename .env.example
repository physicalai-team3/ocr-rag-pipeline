# 복사해서 .env로 저장하면 python -m app 실행 때 읽습니다.

# LAN IP 자동 탐지가 틀릴 때 (예: VPN, 가상 어댑터) 직접 지정
# PUBLIC_HOST=192.168.0.12

# cloudflared 터널 등 외부 HTTPS 주소를 QR에 넣을 때 (지정하면 PUBLIC_HOST보다 우선)
# PUBLIC_BASE_URL=https://xxxx.trycloudflare.com

# PORT=8443
# TOTAL_DOCS=100

# C: cpu/cuda; CUDA needs optional GPU installation (see OCR_EMBEDDING.md).
OCR_BACKEND=rapidocr
OCR_DEVICE=cpu
EMBEDDING_DEVICE=cpu
# OCR_DATA_DIR=data/runtime
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SUPABASE_OWNER_ID=
# SUPABASE_DATASET=conveyor-v1
# OCR_MODEL_DIR=data/runtime/models
